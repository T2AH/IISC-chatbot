# Ignore local artifacts & caches
.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
*.so
*.swp
*.tmp
.DS_Store
.env
.env.*
venv/
.venv/
logs/*
!logs/.gitkeep
data/raw/
data/processed/
