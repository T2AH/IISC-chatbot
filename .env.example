###############################################
# Environment variables for IISc CDS Chatbot  #
###############################################

# Google Gemini API key (used by src/llm/gemini.py and UI)
GEMINI_API_KEY=

# Optional: point API to a specific index directory (api/main.py reads INDEX_DIR)
# Example: INDEX_DIR=data/index/fastembed_bge_small
# INDEX_DIR=

# API Configuration (optional; defaults used if not set)
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Logging level
LOG_LEVEL=INFO

# --- Optional/Legacy Settings (not required for current setup) ---
# Database Configuration (unused by current pipeline; for legacy variants)
DB_HOST=localhost
DB_NAME=research_rag_db
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=5432

# Ollama Configuration (only if you run a local LLM variant)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
